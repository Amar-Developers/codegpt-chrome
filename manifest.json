{
  "manifest_version": 3,
  "name": "Code GPT – AI browser agent",
  "short_name": "Code GPT",
  "version": "2.1.0",
  "description": "Code GPT in your browser: ask about any page, or let the agent do the work. It reads, clicks, types and fills forms for you, and asks before anything important.",
  "homepage_url": "https://codegpt.it.com/chrome",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Code GPT",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://chat.codegpt.it.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.codegpt.it.com/connect*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Open Code GPT"
    },
    "stop_agent": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Stop the browser agent"
    }
  }
}
